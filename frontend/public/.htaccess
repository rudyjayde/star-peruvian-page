Options -MultiViews
RewriteEngine On

# Canonical host: force HTTPS and non-www to avoid duplicate indexing.
RewriteCond %{HTTP_HOST} ^www\.starperuvian\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://starperuvian.com%{REQUEST_URI} [L,R=301]

# Avoid /index.html and /home duplication in search engines.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# SPA routing for the frontend.
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
